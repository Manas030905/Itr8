# =============================================================================
# Builder Hub - environment variables
# Copy to `.env` (root) for local dev. NEVER commit real values.
# The API reads these; the web app only needs API_INTERNAL_URL (see bottom).
# =============================================================================

# --- General ---------------------------------------------------------------
# local | staging | production. Anything other than "local" turns on strict
# checks (secure cookies, no dev-login, non-default SECRET_KEY).
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# postgres:// and postgresql:// URLs (Neon, Supabase, Render) are auto-converted.
DATABASE_URL=postgresql+psycopg://builderhub:builderhub_dev@localhost:5432/builderhub
# Used only by the test-suite. Must be a DIFFERENT database: tests wipe tables.
TEST_DATABASE_URL=postgresql+psycopg://builderhub:builderhub_dev@localhost:5432/builderhub_test

# --- URLs ------------------------------------------------------------------
# Public origin of the WEB app (browser-facing). Used for OAuth redirect URI,
# post-login redirects, and the Origin (CSRF) check. No trailing slash.
FRONTEND_URL=http://localhost:3000

# --- Security --------------------------------------------------------------
# Signs the short-lived OAuth state cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be >= 32 chars and not the default when ENVIRONMENT != local.
SECRET_KEY=change-me-local-only-change-me-local-only
SESSION_COOKIE_NAME=bh_session
SESSION_TTL_DAYS=14

# --- Google OAuth ----------------------------------------------------------
# Create at https://console.cloud.google.com/apis/credentials (OAuth client ID,
# type "Web application"). Authorised redirect URI must be EXACTLY:
#   {FRONTEND_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# If true, additionally require Google's `hd` (hosted domain) claim to match.
# Stricter, but only works if IIIT Raichur mail is Google Workspace. Leave false
# until verified with a real student account (see docs/DECISIONS.md ADR-006).
GOOGLE_REQUIRE_HD=false

# --- Access control (pilot) ------------------------------------------------
# Allowed email domains live in the `colleges` table (seeded: iiitr.ac.in).
# Comma-separated exact email addresses allowed in addition (e.g. your personal
# Gmail for testing). Leave empty in production.
ALLOWED_TEST_EMAILS=
# Local-only shortcut that skips Google. Ignored/forbidden outside ENVIRONMENT=local.
DEV_LOGIN_ENABLED=false

# --- Observability (optional) ---------------------------------------------
SENTRY_DSN=

# --- Web app (apps/web) ----------------------------------------------------
# Where the Next.js server proxies /api/* and makes server-side API calls.
API_INTERNAL_URL=http://localhost:8000
